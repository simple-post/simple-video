{
  "name": "@simple-post/simple-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "simple-video": "bin/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && tsc && node --test dist-test/test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/no-publish.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "commander": "15.0.0",
    "dotenv": "18.0.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "description": "Create depth-based parallax videos from images, for humans and AI agents.",
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "docs",
    "examples",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simple-post/simple-video.git"
  },
  "bugs": {
    "url": "https://github.com/simple-post/simple-video/issues"
  },
  "homepage": "https://github.com/simple-post/simple-video#readme"
}
