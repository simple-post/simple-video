{
  "name": "@simple-post/video",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "simple-video": "bin/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && tsc && node --test dist-test/test/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "release:check": "npm run check && npm run format:check && npm test && npm run check:package",
    "smoke:package": "node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "commander": "15.0.0",
    "dotenv": "18.0.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "description": "Create depth-based parallax videos from images, for humans and AI agents.",
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "docs",
    "examples",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simple-post/simple-video.git"
  },
  "bugs": {
    "url": "https://github.com/simple-post/simple-video/issues"
  },
  "homepage": "https://github.com/simple-post/simple-video#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "author": "SimplePost contributors",
  "keywords": [
    "cli",
    "video",
    "parallax",
    "depthflow",
    "slideshow",
    "ai-agents"
  ]
}
